{
	admin off
	# Clients send no SNI when connecting by IP, and inside the container the
	# local address isn't that IP, so tell Caddy which certificate to use.
	default_sni {$CHRONOS_ADDRESS::80}
	# The container's own trust store is read-only and unused; browsers trust the CA, not Caddy.
	skip_install_trust
}

# ":80" serves plain HTTP (for use behind another reverse proxy, or on localhost).
# A domain ("chronos.example.com") gets a Let's Encrypt certificate automatically.
# An IP ("192.168.0.10") gets a certificate from Caddy's internal CA.
{$CHRONOS_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	# Behind Cloudflare (or another proxy), a visitor who came in over plain
	# HTTP is sent to HTTPS. Without that header (localhost, direct TLS) nothing changes.
	@viaHttp header X-Forwarded-Proto http
	redir @viaHttp https://{host}{uri} 308

	header {
		# Ignored by browsers over plain HTTP, localhost and IP addresses.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# 'wasm-unsafe-eval' lets the SQLite WebAssembly module compile; the
		# ProofHub integration calls its API straight from the browser.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.proofhub.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
	}

	# Hashed file names never change content, so they're cached for a year.
	@asset {
		path /assets/*
		file
	}
	handle @asset {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# A missing asset (e.g. from a page loaded before a redeploy) is a real 404,
	# never index.html cached for a year under a script's URL.
	handle /assets/* {
		header Cache-Control "no-store"
		respond 404
	}

	# Everything else is the app itself, always revalidated.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
