{
	admin off
	# Clients send no SNI when connecting by IP, and inside the container the
	# local address isn't that IP, so tell Caddy which certificate to use.
	default_sni {$CHRONOS_ADDRESS::80}
}

# ":80" serves plain HTTP (for use behind another reverse proxy, or on localhost).
# A domain ("chronos.example.com") gets a Let's Encrypt certificate automatically.
# An IP ("192.168.0.10") gets a certificate from Caddy's internal CA.
{$CHRONOS_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# 'wasm-unsafe-eval' lets the SQLite WebAssembly module compile.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
	}

	# Hashed file names never change content; the HTML entry point must always be revalidated.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@entry path / /index.html
	header @entry Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
