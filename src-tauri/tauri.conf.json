{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronos",
  "version": "0.5.9",
  "identifier": "com.richardson.chronos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chronos",
        "width": 1100,
        "height": 720,
        "minWidth": 380,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4NDUzMjFBOUU5Mzk2NTIKUldSU2xwT2VHakpGK0hWdjEvUVNNdGloc0RFeCtUdG1Da1NnU3ZpbXg2MVYrVlVmVlF4cUNhclUK",
      "endpoints": [
        "https://github.com/RickCaleg/chronos/releases/latest/download/latest.json"
      ]
    }
  }
}
