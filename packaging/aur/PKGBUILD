# Maintainer: Richardson Calegari Saconi <richardson.saconi@outlook.com>
#
# Packaging-only fixes (this file) ship as plain commits to master without a
# new app release/tag. If you got this PKGBUILD from inside a downloaded
# release archive/zip instead of `git clone`, it may be stale — compare
# pkgrel against https://github.com/RickCaleg/chronos/blob/master/packaging/aur/PKGBUILD
#
# Source is a git clone (not a GitHub-generated tarball): GitHub doesn't
# guarantee those archive checksums stay stable long-term, and a git tag
# clone sidesteps that entirely — makepkg verifies it via git itself, so
# sha256sums is intentionally SKIP here (standard for VCS sources).
pkgname=chronos
pkgver=0.3.7
pkgrel=1
pkgdesc="A manual, local-first time tracker with a CLI companion, built with Tauri and React"
arch=('x86_64')
url="https://github.com/RickCaleg/chronos"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme' 'desktop-file-utils')
makedepends=('rust' 'nodejs' 'npm' 'git')
source=("$pkgname::git+https://github.com/RickCaleg/chronos.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$pkgname"

  npm ci

  # makepkg injects RUSTFLAGS (-C force-frame-pointers=yes -C debuginfo=2
  # --remap-path-prefix=..., for its automatic debug-package splitting) and
  # LTO-enabled LDFLAGS/CFLAGS/CXXFLAGS. Any binary here that links a
  # cc-crate-bundled C library (libsqlite3-sys, via sqlx-macros, the app
  # binary, and chronos-cli/rusqlite) ends up missing basic SQLite symbols
  # under those flags (seen: sqlite3_unlock_notify, sqlite3_bind_int64,
  # sqlite3_bind_text, ...) — reproduced consistently under makepkg's
  # environment, never with a plain `cargo`/`npm` toolchain. Unset them for
  # both build commands below.
  unset RUSTFLAGS LDFLAGS CFLAGS CXXFLAGS

  # createUpdaterArtifacts is enabled in tauri.conf.json for the official
  # release pipeline, which signs builds with a private key that only
  # exists in that CI. Disable it here so a plain from-source build
  # (no signing keys available) doesn't fail; distro packages don't go
  # through the in-app updater anyway.
  npm run tauri build -- --bundles deb --config '{"bundle":{"createUpdaterArtifacts":false}}'

  cargo build --release --locked -p chronos-cli
}

package() {
  cd "$pkgname"

  # The .deb Tauri builds already has the correct FHS layout (binary,
  # hicolor icons, .desktop file) generated straight from tauri.conf.json —
  # unpack it instead of hand-maintaining a duplicate of that metadata here.
  local debfile
  debfile=$(find target/release/bundle/deb -name '*.deb')
  mkdir -p "$srcdir/deb-extract"
  ar x "$debfile" --output="$srcdir/deb-extract"
  bsdtar -xf "$srcdir"/deb-extract/data.tar.* -C "$pkgdir"

  install -Dm755 target/release/chronos-cli "$pkgdir/usr/bin/chronos-cli"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
