# Copy to `.env` next to compose.yaml and adjust.

# What Caddy serves. Pick one:
#   chronos.example.com     public domain pointing at this server: automatic HTTPS (Let's Encrypt)
#   192.168.0.10            LAN IP: HTTPS with Caddy's internal CA (browser warns until you trust it)
#   :80                     plain HTTP, only behind something that does HTTPS (Cloudflare Tunnel, another reverse proxy)
CHRONOS_ADDRESS=:80

# Host ports. With another reverse proxy in front, use e.g. CHRONOS_HTTP_PORT=8080.
# With Cloudflare Tunnel no host port is needed: bind them to localhost only,
# e.g. CHRONOS_HTTP_PORT=127.0.0.1:8080 and CHRONOS_HTTPS_PORT=127.0.0.1:8443.
CHRONOS_HTTP_PORT=80
CHRONOS_HTTPS_PORT=443

# Image tag to pull (a release like 0.5.12, or latest).
CHRONOS_VERSION=latest

# Cloudflare Tunnel (docs/WEB.md): uncomment both lines and paste the tunnel token.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
